<Window x:Class="WebCamCap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebCamCap"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image x:Name="ImageFrame" Stretch="Uniform" Grid.Row="0" />
        <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1">
            <Button x:Name="BtnStart" Content="Start" Width="100" Height="30" Margin="5" Click="BtnStart_Click" />
            <Button x:Name="BtnStop" Content="Stop" Width="100" Height="30" Margin="5" Click="BtnStop_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
    
</Window>
